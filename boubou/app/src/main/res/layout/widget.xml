<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🌺 BOUBOU  ·  Saint-Brès" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:singleLine="true"/>
  <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻ —" android:textColor="#B9C9D9" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp">
  <FrameLayout android:layout_width="74dp" android:layout_height="match_parent">
   <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🌺" android:textSize="45sp"/>
   <ImageView android:id="@+id/plant" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Boubou" android:scaleType="fitCenter"/>
  </FrameLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
   <TextView android:id="@+id/current" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actuellement —°" android:textSize="11sp" android:textColor="#C5D4E4" android:singleLine="true"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— °C" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:text="MIN. NUIT" android:textSize="9sp" android:textColor="#B9C9D9"/>
   </LinearLayout>
   <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/status_bg" android:padding="5dp" android:gravity="center" android:text="Météo en cours…" android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:singleLine="true" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/advice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="4dp" android:text="Analyse météo…" android:textColor="#E2EAF3" android:textSize="10sp" android:singleLine="true" android:ellipsize="end"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5">
  <TextView android:id="@+id/night0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/night_bg" android:gravity="center" android:paddingVertical="7dp" android:text="Sam\n—°" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
  <TextView android:id="@+id/night1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/night_bg" android:gravity="center" android:paddingVertical="7dp" android:text="Dim\n—°" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
  <TextView android:id="@+id/night2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/night_bg" android:gravity="center" android:paddingVertical="7dp" android:text="Lun\n—°" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
  <TextView android:id="@+id/night3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/night_bg" android:gravity="center" android:paddingVertical="7dp" android:text="Mar\n—°" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
  <TextView android:id="@+id/night4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/night_bg" android:gravity="center" android:paddingVertical="7dp" android:text="Mer\n—°" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
 </LinearLayout>
 <TextView android:id="@+id/weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Vent —  ·  Rafales —  ·  Pluie —" android:textColor="#B9C9D9" android:textSize="10sp" android:singleLine="true"/>
</LinearLayout>